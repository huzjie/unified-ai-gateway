# ===== Unified AI Gateway 环境变量模板 =====
# 复制为 .env 并填写后：npm run dev 或 docker compose up 即可运行

# ---- 服务监听 ----
UAG_PORT=8787
UAG_HOST=0.0.0.0

# ---- 存储 ----
UAG_DATABASE_PATH=./data/gateway.db

# ---- 日志 ----
UAG_LOG_LEVEL=info

# ---- 管理员（首启初始化，登录签发 JWT） ----
UAG_ADMIN_USERNAME=admin
UAG_ADMIN_PASSWORD=change-me-please

# ---- 管理面 JWT（生产必改） ----
UAG_JWT_SECRET=please-change-me-to-a-long-random-string

# ---- 限流 ----
UAG_GLOBAL_QPS=1000
UAG_GLOBAL_CONCURRENCY=200

# ---- 超时与重试 ----
UAG_DEFAULT_TIMEOUT_MS=30000
UAG_DEFAULT_MAX_RETRIES=2

# ---- 熔断 ----
UAG_CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
UAG_CIRCUIT_BREAKER_MIN_REQUESTS=10
UAG_CIRCUIT_BREAKER_OPEN_MS=30000

# ---- Provider Key 加密（AES-256-GCM，32 字节；未配置拒绝启动） ----
UAG_PROVIDER_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ---- Web 控制台 ----
UAG_WEB_ORIGIN=http://localhost:5173

# ---- Redis（可选，P2 共享状态；留空则不启用） ----
UAG_REDIS_URL=

# ---- Mock Provider（默认开启便于演示/测试） ----
UAG_MOCK_PROVIDER_ENABLED=true

# ---- 日志保留 ----
UAG_LOG_RETENTION_DAYS=30

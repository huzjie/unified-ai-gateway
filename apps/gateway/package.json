{
  "name": "@uag/gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Unified AI Gateway 网关服务（Fastify）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",

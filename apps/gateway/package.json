    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.0",
    "@uag/core": "workspace:*",
    "@uag/providers": "workspace:*",
    "@uag/storage": "workspace:*",
    "@uag/types": "workspace:*",
    "fastify": "^5.12.4",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
